rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function validProductImageKey(data) {
      return !data.keys().hasAny(['imageKey'])
        || (
          data.imageKey is string
          && data.imageKey.matches(
            'products/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.(jpg|png|webp)'
          )
        );
    }

    function validProduct(data, productId) {
      return data.keys().hasAll([
          'name',
          'description',
          'category',
          'price',
          'brand',
          'stock',
          'imageUrl',
          'published'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'description',
          'category',
          'price',
          'brand',
          'stock',
          'imageUrl',
          'imageKey',
          'published',
          'sourceUrl'
        ])
        && (
          !data.keys().hasAny(['id'])
          || (
            data.id is string
            && data.id == productId
          )
        )
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 1000
        && data.category in [
          'writing-instruments',
          'stationery',
          'office-supplies',
          'desk-accessories'
        ]
        && data.price is number
        && data.price > 0
        && data.price <= 1000000
        && math.abs(
          data.price * 100 - math.round(data.price * 100)
        ) <= 0.00000001
        && data.brand is string
        && data.brand.size() > 0
        && data.brand.size() <= 80
        && data.stock is int
        && data.stock >= 0
        && data.stock <= 1000000
        && data.imageUrl is string
        && (
          data.imageUrl == '/images/product-placeholder.svg'
          || data.imageUrl.matches('https://.*')
        )
        && validProductImageKey(data)
        && data.published is bool
        && (
          !data.keys().hasAny(['sourceUrl'])
          || (
            data.sourceUrl is string
            && data.sourceUrl.matches('https://.*')
          )
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.role == 'customer'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      match /favorites/{productId} {
        function productIsPublished() {
          let productPath =
            /databases/$(database)/documents/products/$(productId);

          return exists(productPath)
            && get(productPath).data.published == true;
        }

        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'productId',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'productId',
            'createdAt'
          ])
          && request.resource.data.productId is string
          && request.resource.data.productId == productId
          && request.resource.data.createdAt == request.time
          && productIsPublished();

        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource == null
          || isOwner(resource.data.userId)
        );

      allow list: if isAdmin()
        || isOwner(resource.data.userId);

      allow create, delete: if false;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status'])
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['status'])
        && request.resource.data.status in [
          'pending',
          'processing',
          'completed',
          'cancelled'
        ];
    }

    match /products/{productId} {
      allow get: if isAdmin()
        || resource == null
        || resource.data.published == true;

      allow list: if isAdmin()
        || resource.data.published == true;

      allow create: if isAdmin()
        && validProduct(request.resource.data, productId);

      allow update: if isAdmin()
        && validProduct(request.resource.data, productId);

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
