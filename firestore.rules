rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.role == 'customer'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      match /favorites/{productId} {
        function productIsPublished() {
          let productPath =
            /databases/$(database)/documents/products/$(productId);
          return exists(productPath)
            && get(productPath).data.published == true;
        }

        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'productId',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'productId',
            'createdAt'
          ])
          && request.resource.data.productId is string
          && request.resource.data.productId == productId
          && request.resource.data.createdAt == request.time
          && productIsPublished();

        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn()
        && (
          resource == null
          || isOwner(resource.data.userId)
        );

      allow list: if isOwner(resource.data.userId);

      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow get: if resource == null
        || resource.data.published == true;
      allow list: if resource.data.published == true;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
